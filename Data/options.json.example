{
    "debug": false,
    "recovery_mod": false,
    "get_server": false,
    "run_sheets": true,
    "auto_check": true,
    "auto_reset": true,
    "require_board_number": true,
    "send_board_number": true,
    "admin_session_seconds": 600,
    "flash_mode": "eeprom_spi",
    "author": "",
    "auto_board": true,
    "board_prefix": "Board",
    "disable_shell_on_flash": false,
    "install_script": "install.sh",
    "flash_watchdog_ms": 420000,
    "gs_custom_config": true,
    "gs_credentials_path": "Data/your-service-account-key.json",
    "gs_spreadsheet_name": "Database_board_serial",
    "gs_sheet_title": "{date}_{author}",
    "gs_sheet_rows": 500,
    "gs_sheet_cols": 2,
    "gs_sheet_refresh_seconds": 60,
    "gs_style_rules_path": "Data/conditional_format.json",
    "gs_row_template": "{board}{:<18}|{:<3}{serial}{:<3}|",
    "gs_header_template": "{board}{:<16}Всего:{:<1}{count}{:<16}|{:<2}{serial}{:<2}|",
    "serial_prefix": "CUINF",
    "board_check": false,
    "dhcp_interface": "",
    "dhcp_server_ip": "15.15.15.1",
    "dhcp_assigned_ip": "15.15.15.15",
    "dhcp_subnet_mask": "255.255.255.0",
    "dhcp_lease_time": 60,
    "ssh_user": "root",
    "ssh_password": "",
    "phone_path": "/home/root/",
    "mtd0": "/dev/mtd0",
    "nand_command": "/usr/sbin/nandwrite.mtd-utils -p /dev/mtd0",
    "flash_erase": "/usr/sbin/flash_erase /dev/mtd0 0 1",
    "db_user": "dssadmin",
    "db_password": "",
    "db_host": "127.0.0.1",
    "db_port": 5432,
    "db_name": "devices",
    "counter_file": "Data/board_counter.txt"
}